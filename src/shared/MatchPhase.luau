--!strict
-- Фазы матча. Единственное место, где эти имена заданы.
-- Лежат в Shared, потому что фазу знает и сервер, и клиент:
-- сервер её назначает, клиент по ней рисует интерфейс.

local MatchPhase = {
	-- Приветствие перед схваткой: руки сходятся, счёт ещё не идёт.
	Ritual = "Ritual",
	-- Охота: игроки маневрируют большими пальцами.
	Hunt = "Hunt",
	-- Прижатие: один палец накрыт, второй пытается вырваться.
	Pin = "Pin",
	-- Раунд завершён, счёт обновлён, идёт пауза перед следующим.
	RoundEnd = "RoundEnd",
	-- Матч завершён целиком.
	MatchEnd = "MatchEnd",
}

export type Phase = string

return table.freeze(MatchPhase)
